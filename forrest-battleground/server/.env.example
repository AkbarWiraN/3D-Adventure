# Environment template — JANGAN commit nilai sungguhan
# Salin ke .env lalu isi, chmod 600
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Origin production GitHub Pages (tanpa slash akhir, tanpa path)
FRONTEND_ORIGINS=https://akbarwiran.github.io
DATABASE_FILE=/var/lib/forest-battleground/game.sqlite
# GENERATE lokal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=GENERATE_RANDOM_SECRET_LOCALLY_DO_NOT_COMMIT
ACCESS_TOKEN_TTL_SECONDS=1200
WORLD_SEED=20261104
WORLD_VERSION=forest-v1
ROOM_HARD_CAP=8
TICK_HZ=20
SNAPSHOT_HZ=10
ENEMY_MAP_HZ=2
COMBAT_LOGOUT_SECONDS=10